# Never commit the 1 GB test file or transferred copies.
data.bin
*.bin
received*
*.iso

# Raw measurement dumps stay on the VMs; commit only summaries and charts.
results/raw/
results/**/ping.txt
results/**/*.json

# Phone footage - far too large for git.
video/raw-phone-clips/
*.mp4
*.mov

# Build output
*.o
ftr
src/ftr
bench/**/ft

# Bench runtime state: node IPs / key paths — machine-specific, never commit.
bench/aws/hosts.env
bench/aws/*state*.env
bench/aws/results/
*.jsonl

# Report stays local - not published to the group repo.
report/
